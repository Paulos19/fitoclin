{
    "name": "Fitoclin: Transcrição Profissional com Gemini",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "fitoclin-transcription-start",
                "options": {}
            },
            "id": "webhook-trigger",
            "name": "Webhook Start",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                250,
                300
            ]
        },
        {
            "parameters": {
                "url": "={{ $json.audioUrl }}",
                "responseFormat": "file",
                "options": {}
            },
            "id": "download-audio",
            "name": "Baixar Áudio",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.1,
            "position": [
                470,
                300
            ]
        },
        {
            "parameters": {
                "model": "gemini-1.5-flash",
                "options": {
                    "maxOutputTokens": 2048,
                    "temperature": 0.2
                },
                "prompt": "Você é uma secretária médica experiente. Transcreva fielmente o áudio da consulta em anexo. Retorne apenas o texto transcrito, sem introduções.",
                "inputBinaryProperty": "data"
            },
            "id": "gemini-transcription",
            "name": "Google Gemini",
            "type": "n8n-nodes-base.googleGemini",
            "typeVersion": 1,
            "position": [
                690,
                300
            ],
            "credentials": {
                "googleGeminiApi": {
                    "id": "SEU_ID_CREDENTIAL_GEMINI",
                    "name": "Google Gemini API"
                }
            }
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://seu-dominio.com/api/n8n/transcription",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "x-n8n-secret",
                            "value": "EXTRACT_FROM_DOTENV"
                        }
                    ]
                },
                "sendBody": true,
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "recordId",
                            "value": "={{ $('Webhook Start').item.json.recordId }}"
                        },
                        {
                            "name": "transcriptionText",
                            "value": "={{ $json.text }}"
                        },
                        {
                            "name": "status",
                            "value": "COMPLETED"
                        }
                    ]
                },
                "options": {}
            },
            "id": "update-database",
            "name": "Atualizar Fitoclin",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.1,
            "position": [
                910,
                300
            ]
        }
    ],
    "connections": {
        "Webhook Start": {
            "main": [
                [
                    {
                        "node": "Baixar Áudio",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Baixar Áudio": {
            "main": [
                [
                    {
                        "node": "Google Gemini",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Google Gemini": {
            "main": [
                [
                    {
                        "node": "Atualizar Fitoclin",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}